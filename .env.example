# ---------------------------------------------------------------------------
# Environment contract for this test framework.
#
# IMPORTANT: this file is DOCUMENTATION ONLY. Nothing in the framework reads
# a .env file -- there is no dotenv dependency. Copying this to `.env` and
# filling it in will have NO effect.
#
# Supply these variables through your shell or your CI provider instead:
#
#   APP_TARGET=staging BASE_URL=https://staging.example.com npm test
#
# or, for a whole session:
#
#   export APP_TARGET=staging
#   export BASE_URL=https://staging.example.com
#
# A loader will be considered when the variable count or the number of
# contributors makes shell export genuinely inconvenient. It is not needed yet.
# ---------------------------------------------------------------------------


# Which deployed application to test. Optional.
#
# Valid values: saucedemo | staging | production
# Unset defaults to `saucedemo`, so a fresh clone runs with no configuration.
# Any other value fails immediately, before a browser is started.
APP_TARGET=saucedemo


# Absolute http(s) URL of the application under test.
#
# - For APP_TARGET=saucedemo this is OPTIONAL. The registry supplies
#   https://www.saucedemo.com. Setting it is treated as an intentional
#   override and is reported as `baseURLSource=override` at startup.
# - For APP_TARGET=staging or production it is REQUIRED. Those targets have no
#   default URL, so omitting it is an error rather than a silent fall back to
#   the public demo site.
#
# Must parse as an absolute URL and use the http or https protocol.
# BASE_URL=https://staging.example.com


# Execution context. Normally set by the CI provider, not by hand.
#
# Accepted: 1 | true | yes | on   -> CI      (enables retries and forbidOnly)
#           0 | false | no | off  -> local
# Unset defaults to `local`. Parsed explicitly, so `CI=0` means local rather
# than being treated as truthy.
# CI=true


# ---------------------------------------------------------------------------
# Credentials are deliberately NOT part of this contract.
#
# The Sauce Demo test accounts are that site's own published demo values and
# live in src/data/users.ts. The configuration object holds no credentials, so
# it cannot leak them through a log line or a serialised report.
#
# Never place real credentials in this repository or its public CI pipeline.
# See docs/security-testing-policy.md.
# ---------------------------------------------------------------------------
